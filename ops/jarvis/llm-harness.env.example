# Copy to llm-harness.env (ignored by Git), then fill these values locally.
# Never commit provider keys. Process environment overrides this local file.
# Provider options: openai_compatible (default) or anthropic.
# For Claude: use https://api.anthropic.com/v1/messages and a Claude model enabled for your account.
# For OpenAI-compatible providers: endpoint must end in /chat/completions.
# Remote providers must use HTTPS. Plain HTTP is accepted only for local loopback models.
JARVIS_LLM_PROVIDER=anthropic
JARVIS_LLM_ENDPOINT=https://api.anthropic.com/v1/messages
JARVIS_LLM_MODEL=
JARVIS_LLM_API_KEY=
JARVIS_LLM_TIMEOUT_SECONDS=30
JARVIS_LLM_MAX_TOKENS=512
