# Copy to llm-harness.env (ignored by Git), then fill these values locally.
# Use an approved OpenAI-compatible chat-completions endpoint.
# Remote providers must use HTTPS. Plain HTTP is accepted only on localhost.
JARVIS_LLM_ENDPOINT=
JARVIS_LLM_MODEL=
JARVIS_LLM_API_KEY=
JARVIS_LLM_TIMEOUT_SECONDS=30
JARVIS_LLM_MAX_TOKENS=512
