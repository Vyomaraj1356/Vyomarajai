# Owner mailbox adapter — secret values NEVER belong in Git
# The address is the owner's public contact; publish it via set_public_contact.py, do not hardcode it.
VYOMARAJ_OWNER_MAILBOX=owner@example.com
MAILBOX_PROVIDER=GMAIL_IMAP
MAILBOX_IMAP_HOST=imap.gmail.com
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=smtp.gmail.com
MAILBOX_SMTP_PORT=465
MAILBOX_USERNAME=owner@example.com
MAILBOX_APP_PASSWORD_ENV=VYOMARAJ_GMAIL_APP_PASSWORD
MAILBOX_POLL_SECONDS=30
MAILBOX_AUTOREPLY_ENABLED=false
MAILBOX_DRY_RUN=true
