# Vyomaraj DR configuration — safety-corrected
# Scope: repository snapshot replication and controlled recovery metadata.
# This file MUST NOT be interpreted as proof of live runtime connectivity.
VERSION=1.0
PRIMARY_REPO=Vyomaraj1356/Vyomarajai
SECONDARY_REPO=deepakGoyal1356/Vyomaraj-Agent-6d64e
SYNC_DIRECTION=PRIMARY_MAIN_TO_SECONDARY_MAIN
SYNC_SCHEDULE=*/30 * * * *
REALTIME_SYNC_ON_PUSH=true
BIDIRECTIONAL_RUNTIME_SYNC=false
AUTOMATIC_REVERSE_OVERWRITE=false
FORCE_PUSH=false
TARGET_ONLY_FILE_REMOVAL=false
ZERO_RPO_VERIFIED=false
ZERO_RTO_VERIFIED=false
AUTOMATIC_FAILOVER_VERIFIED=false
AUTOMATIC_FAILBACK_VERIFIED=false
RUNTIME_DR_VERIFIED=false
EXTERNAL_SOCIAL_INTEGRATIONS_VERIFIED=false
PRODUCTION_AI_PROVIDERS_VERIFIED=false
AUTOMATIC_PUBLISHING_VERIFIED=false
AUTOMATIC_MONETIZATION_VERIFIED=false
ALL_PORTS_VERIFIED=false
ALL_HEARTBEATS_VERIFIED=false
ALL_LINKS_VERIFIED=false
FENCING_REQUIRED_FOR_TRAFFIC_SWITCH=true
RECOVERY_MODE=HUMAN_REVIEWED
HEARTBEAT_INTERVAL_SECONDS=1800
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=3
STATE_FILE=/tmp/vyomaraj-dr-state
LOCK_FILE=/tmp/vyomaraj-dr.lock
HEARTBEAT_FILE=.vyomaraj-dr-heartbeat.log
CURL_TIMEOUT=8
SWITCH_TIMEOUT=15
# Secret names only. Values must come from the runtime secret manager/GitHub Actions secrets.
GITHUB_PRIMARY_TOKEN_ENV=VYOMARAJ_GH_PAT
GITHUB_SECONDARY_TOKEN_ENV=DR_SECONDARY_TOKEN
# No token values, phone numbers, payout values or private URLs belong in this file.
