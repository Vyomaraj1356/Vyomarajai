# Copy to ops/dr/dr.env on the independent DR monitor.
# NEVER commit real secrets.
# V15.1 Final Market Ready ?v=151 678 LIVE 694 total — Vyomaraj DR Live Config

VERSION=V15.1
BUILD_DATE=2026-09-30
INDEX_VERSION=?v=151

PRIMARY_REPO=Vyomaraj1356/Vyomarajai
SECONDARY_REPO=deepakGoyal1356/Vyomaraj-Agent

PRIMARY_HEALTH_URL=https://Vyomaraj1356.github.io/Vyomarajai/
SECONDARY_HEALTH_URL=https://deepakGoyal1356.github.io/Vyomaraj-Agent/
SECONDARY_FALLBACK_HEALTH_URL=https://Vyomaraj1356.github.io/Vyomarajai/
BUSINESS_PROBE_URL=https://Vyomaraj1356.github.io/Vyomarajai/
SECONDARY_BUSINESS_PROBE_URL=https://deepakGoyal1356.github.io/Vyomaraj-Agent/

PRIMARY_PAGES_URL=https://Vyomaraj1356.github.io/Vyomarajai/?v=151
SECONDARY_PAGES_URL=https://deepakGoyal1356.github.io/Vyomaraj-Agent/?v=151

# Generic traffic/DNS/load-balancer control endpoint.
# It must accept {"target":"primary"|"secondary"} and be idempotent.
DR_SWITCH_URL=https://CONTROL.example.com/vyomaraj/traffic/switch
DR_SWITCH_TOKEN=REPLACE_ME

# Optional primary fencing endpoint. Required for systems with writes/state.
FENCE_PRIMARY_URL=
FENCE_PRIMARY_TOKEN=

# Optional secondary activation endpoint.
SECONDARY_ACTIVATE_URL=
SECONDARY_ACTIVATE_TOKEN=

# Optional replication/resync verification endpoint.
RESYNC_CHECK_URL=

FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=3
PROBE_INTERVAL_SECONDS=2
POST_SWITCH_WAIT_SECONDS=5
CURL_TIMEOUT=8
SWITCH_TIMEOUT=15

STATE_FILE=/tmp/vyomaraj-dr-state
LOCK_FILE=/tmp/vyomaraj-dr.lock
HEARTBEAT_FILE=.vyomaraj-dr-heartbeat.log
HEARTBEAT_INTERVAL_SECONDS=1800

# PAT secrets required for DR sync — set in GitHub Settings → Secrets → Actions
# VYOMARAJ_GH_PAT = classic PAT repo scope for Vyomaraj1356 + deepakGoyal1356
# DR_SECONDARY_REPO = deepakGoyal1356/Vyomaraj-Agent
# DR_SECONDARY_TOKEN = classic PAT repo scope for secondary
